NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/stocktrade
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
TRADING_ENABLED=true

# External stock data provider (optional — falls back to mock if empty)
STOCK_API_PROVIDER=finnhub
STOCK_API_KEY=
STOCK_API_BASE=https://finnhub.io/api/v1
